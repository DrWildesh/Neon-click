<?xml version='1.0' encoding='utf-8'?>
<!-- Cordova config.xml - updated for com.gasanaa.neonclick and admob test app id -->
<widget id="com.gasanaa.neonclick" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
  <name>Neon Clicker Pro</name>
  <description>Play store grade arcade neon clicker game with full ad monetization.</description>
  <author email="dev@example.com">Developer Name</author>

  <content src="index.html" />

  <!-- Essential Screen Preferences -->
  <preference name="AndroidXEnabled" value="true" />
  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="true" />

  <!-- Internet / Navigation -->
  <access origin="*" />
  <allow-intent href="http://*/*" />
  <allow-intent href="https://*/*" />
  <allow-navigation href="*" />

  <platform name="android">
    <!-- Ensure required permissions -->
    <config-file target="AndroidManifest.xml" parent="/manifest">
      <uses-permission android:name="android.permission.INTERNET" />
      <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    </config-file>

    <!-- Enable cleartext if needed for debugging (set to false for production if not required) -->
    <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
      <application android:usesCleartextTraffic="true" />
    </edit-config>

    <!-- Splash / Icon -->
    <icon src="res/icon.png" />
    <splash src="res/splash.png" />
  </platform>

  <!-- Splash preferences -->
  <preference name="SplashScreen" value="screen" />
  <preference name="SplashScreenDelay" value="3000" />
  <preference name="AutoHideSplashScreen" value="true" />

  <!-- AdMob plugin (admob-plus-cordova) using Google test App ID for Android -->
  <plugin name="admob-plus-cordova" spec="^1.28.0">
    <!-- Test App ID (AdMob sample) - leave as-is for testing, replace with your real App ID later -->
    <variable name="APP_ID_ANDROID" value="ca-app-pub-3940256099942544~3347511713" />
  </plugin>

</widget>
