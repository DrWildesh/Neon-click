<?xml version='1.0' encoding='utf-8'?>
<!-- CHANGE PACKAGE ID HERE -->
<widget id="com.yourdomain.neonclicker" version="1.0.0" xmlns="http://w3.org" xmlns:android="http://android.com">
    
    <!-- CHANGE APP NAME HERE -->
    <name>Neon Clicker Pro</name>
    
    <description>Play store grade arcade neon clicker game with full ad monetization.</description>
    <author email="dev@example.com">Developer Name</author>
    
    <content src="index.html" />

    <!-- Essential Screen Preferences -->
    <preference name="AndroidXEnabled" value="true" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="true" />

    <!-- 1. Internet Access and Network Security Enabling -->
    <access origin="*" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <allow-navigation href="*" />
  <platform name="android">
        <!-- Force Manifest to explicitly clear internet permissions for AdMob servers -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
        <config-file target="AndroidManifest.xml" mode="merge" parent="/manifest">
            <uses-permission android:name="android.permission.INTERNET" />
            <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
        </config-file>

        <!-- Global configuration for icon and splash screen -->
    <preference name="SplashScreen" value="screen" />
    <preference name="SplashScreenDelay" value="3000" /> <!-- Shows for 3 seconds -->
    <preference name="AutoHideSplashScreen" value="true" />

    <platform name="android">
        <!-- Directs the builder to use your root res/ folder assets -->
        <icon src="res/icon.png" />
        <splash src="res/splash.png" />
    </platform>

    <!-- 2. Official AdMob SDK Native Integration Plugin -->
    <!-- Connects your pre-existing HTML scripts to internal Android components -->
    <plugin name="admob-plus-cordova" spec="^1.28.0">
        <!-- REPLACE VALUE WITH YOUR ACTUAL ADMOB APP ID FROM ADMOB CONSOLE -->
        <variable name="APP_ID_ANDROID" value="ca-app-pub-3940256099942544~3347511713" />
    </plugin>
</widget>
